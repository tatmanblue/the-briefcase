@page "/files/{Id:guid}"
@inject Briefcase.Registry.FileRegistry FileRegistry
@inject Briefcase.Registry.ProjectRegistry ProjectRegistry
@inject ContentRenderer Renderer
@inject FileOperationsService OperationsService
@inject FileContentService ContentService
@inject FileTypeClassifier Classifier
@inject Briefcase.Services.Shell.IShellService ShellService
@inject AppSettings Settings
@inject NavigationManager Nav

<PageTitle>@(entry?.Name ?? "File")</PageTitle>

<p><a href="/">&larr; Back to files</a></p>

@if (notFound)
{
    <p class="error">File not found.</p>
}
else if (entry != null)
{
    <h1>@entry.Name</h1>

    <div class="metadata">
        <span>@FormatSize(fileSize)</span>
        <span>Last modified @(lastModified?.ToLocalTime().ToString("g") ?? "-")</span>
        <span>Project: @(currentProjectName ?? "None")</span>
        @if (entry.IsArchived)
        {
            <span class="badge">Archived</span>
        }
    </div>

    <div class="toolbar">
        @if (!editMode && fileType?.IsTextBased == true)
        {
            <label class="checkbox">
                <input type="checkbox" @bind="showRaw" />
                Show raw source
            </label>
        }
        @if (isEditable && !editMode)
        {
            <button class="btn" @onclick="StartEdit">Edit</button>
        }
        @if (ShellService.IsSupported && !isOpenBlocked)
        {
            <button class="btn" @onclick="OpenInDefaultApp"
                    title="Open this file with the application your operating system associates with it">Open in default app</button>
        }
        @if (ShellService.IsSupported)
        {
            <button class="btn" @onclick="ShowInFolder">Show in folder</button>
        }
        <a class="btn" href="@($"{contentUrl}&download=true")">Download</a>
        <button class="btn" @onclick="() => OpenAssignProject()">Project</button>
        <button class="btn" @onclick="() => OpenMove()">Move</button>
        <button class="btn btn-danger" @onclick="() => OpenDelete()">Delete</button>
    </div>

    @if (shellError != null)
    {
        <p class="error">@shellError</p>
    }

    @if (readError != null)
    {
        <p class="error">@readError</p>
    }
    else if (editMode)
    {
        @if (editError != null)
        {
            <p class="error">@editError</p>
        }
        <textarea class="edit-textarea" @bind="editContent"></textarea>
        <div class="modal-actions">
            <button class="btn" @onclick="CancelEdit" disabled="@editBusy">Cancel</button>
            <button class="btn btn-primary" @onclick="SaveEdit" disabled="@editBusy">
                @(editBusy ? "Saving..." : "Save")
            </button>
        </div>
    }
    else if (showRaw && fileType?.IsTextBased == true)
    {
        <pre class="raw-content">@content</pre>
    }
    else
    {
        switch (fileType?.Kind)
        {
            case FileKind.Markdown:
            case FileKind.Text:
                <div class="rendered-content">
                    @((MarkupString)renderedHtml)
                </div>
                break;
            case FileKind.Image:
                <div class="media-viewer">
                    <img src="@contentUrl" alt="@entry.Name" />
                </div>
                break;
            case FileKind.Pdf:
                <iframe class="pdf-viewer" src="@contentUrl" title="@entry.Name"></iframe>
                break;
            case FileKind.Audio:
                <div class="media-viewer">
                    <audio controls src="@contentUrl"></audio>
                </div>
                break;
            case FileKind.Video:
                <div class="media-viewer">
                    <video controls src="@contentUrl"></video>
                </div>
                break;
            default:
                <div class="no-preview">
                    <p>This file type (@fileType?.MimeType) can't be previewed in the browser.</p>
                    <div class="no-preview-actions">
                        @if (ShellService.IsSupported && !isOpenBlocked)
                        {
                            <button class="btn btn-primary" @onclick="OpenInDefaultApp">Open in default app</button>
                        }
                        @if (ShellService.IsSupported)
                        {
                            <button class="btn" @onclick="ShowInFolder">Show in folder</button>
                        }
                        <a class="btn" href="@($"{contentUrl}&download=true")">Download</a>
                    </div>
                    @if (isOpenBlocked)
                    {
                        <p class="hint">Opening is disabled for this file type because it can run programs.</p>
                    }
                </div>
                break;
        }
    }
}

<MoveFileDialog Visible="moveVisible"
                FileName="@(entry?.Name ?? "")"
                Roots="Settings.BriefcasePaths"
                Busy="moveBusy"
                Error="@moveError"
                OnCancel="CloseMove"
                OnConfirm="ConfirmMove" />

<ConfirmDeleteDialog Visible="deleteVisible"
                     FileName="@(entry?.Name ?? "")"
                     Busy="deleteBusy"
                     Error="@deleteError"
                     OnCancel="CloseDelete"
                     OnConfirm="ConfirmDelete" />

<AssignProjectDialog Visible="assignVisible"
                      FileName="@(entry?.Name ?? "")"
                      Projects="ProjectRegistry.GetAll()"
                      Busy="assignBusy"
                      Error="@assignError"
                      OnCancel="CloseAssignProject"
                      OnConfirm="ConfirmAssignProject" />

@code {
    [Parameter] public Guid Id { get; set; }

    private Briefcase.Registry.RegistryEntry? entry;
    private bool notFound;
    private string content = "";
    private string renderedHtml = "";
    private string? readError;
    private bool showRaw;
    private long? fileSize;
    private DateTime? lastModified;
    private string? currentProjectName;
    private FileTypeInfo? fileType;
    // Includes the last-write time so the browser refetches images/media after the file changes.
    private string contentUrl = "";
    private bool isOpenBlocked;
    private string? shellError;

    private bool moveVisible;
    private bool moveBusy;
    private string? moveError;

    private bool deleteVisible;
    private bool deleteBusy;
    private string? deleteError;

    private bool assignVisible;
    private bool assignBusy;
    private string? assignError;

    private bool isEditable;
    private bool editMode;
    private string editContent = "";
    private bool editBusy;
    private string? editError;

    protected override void OnParametersSet() => Load();

    private void Load()
    {
        editMode = false;
        editError = null;

        entry = FileRegistry.GetById(Id);
        if (entry is null)
        {
            notFound = true;
            return;
        }

        notFound = false;
        readError = null;
        shellError = null;
        content = "";
        renderedHtml = "";
        isOpenBlocked = Settings.IsOpenBlocked(entry.Name);

        if (!File.Exists(entry.AbsolutePath))
        {
            fileType = null;
            isEditable = false;
            readError = $"File '{entry.Name}' is registered but no longer exists on disk.";
            return;
        }

        var info = new FileInfo(entry.AbsolutePath);
        fileSize = info.Length;
        lastModified = info.LastWriteTimeUtc;
        currentProjectName = ProjectRegistry.FindProjectForFile(entry.Id)?.projectName;
        contentUrl = $"/files/{entry.Id}/content?v={info.LastWriteTimeUtc.Ticks}";

        // Text editing only makes sense for text-based files, whatever the editable list says.
        fileType = Classifier.Classify(entry.Name, entry.AbsolutePath);
        isEditable = fileType.IsTextBased
            && Settings.EditableExtensions.Contains(Path.GetExtension(entry.Name), StringComparer.OrdinalIgnoreCase);

        // Binary files are displayed straight from the content endpoint; only text is read here.
        if (!fileType.IsTextBased)
            return;

        try
        {
            content = File.ReadAllText(entry.AbsolutePath);
            if (fileType.Kind is FileKind.Markdown or FileKind.Text)
                renderedHtml = Renderer.RenderToHtml(entry.Name, content);
        }
        catch (Exception ex)
        {
            readError = $"Failed to read file '{entry.Name}': {ex.Message}";
        }
    }

    private void StartEdit()
    {
        editContent = content;
        editError = null;
        editMode = true;
    }

    private void CancelEdit()
    {
        editMode = false;
        editError = null;
    }

    private void SaveEdit()
    {
        if (entry is null || lastModified is null) return;

        editBusy = true;
        var result = ContentService.UpdateFile(entry.Id, editContent, lastModified);
        editBusy = false;

        if (!result.Success)
        {
            editError = result.Error;
            return;
        }

        Load();
    }

    private void OpenInDefaultApp()
    {
        if (entry is null) return;
        shellError = OperationsService.OpenInDefaultApp(entry.Id);
    }

    private void ShowInFolder()
    {
        if (entry is null) return;
        shellError = OperationsService.ShowInFolder(entry.Id);
    }

    private static string FormatSize(long? bytes)
    {
        if (bytes is null) return "-";
        double size = bytes.Value;
        string[] units = ["B", "KB", "MB", "GB"];
        var unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }
        return $"{size:0.#} {units[unitIndex]}";
    }

    private void OpenMove()
    {
        moveError = null;
        moveVisible = true;
    }

    private void CloseMove()
    {
        moveVisible = false;
        moveError = null;
    }

    private async Task ConfirmMove((string Root, string? Subfolder) destination)
    {
        if (entry is null) return;
        moveBusy = true;
        var error = await OperationsService.MoveFile(entry.Id, destination.Root, destination.Subfolder);
        moveBusy = false;

        if (error != null)
        {
            moveError = error;
            return;
        }

        CloseMove();
        Load();
    }

    private void OpenDelete()
    {
        deleteError = null;
        deleteVisible = true;
    }

    private void CloseDelete()
    {
        deleteVisible = false;
        deleteError = null;
    }

    private async Task ConfirmDelete()
    {
        if (entry is null) return;
        deleteBusy = true;
        var error = await OperationsService.DeleteFile(entry.Id);
        deleteBusy = false;

        if (error != null)
        {
            deleteError = error;
            return;
        }

        Nav.NavigateTo("/");
    }

    private void OpenAssignProject()
    {
        assignError = null;
        assignVisible = true;
    }

    private void CloseAssignProject()
    {
        assignVisible = false;
        assignError = null;
    }

    private async Task ConfirmAssignProject((Guid? ExistingProjectId, string? NewProjectName) selection)
    {
        if (entry is null) return;
        assignBusy = true;
        var error = await OperationsService.AssignProject(entry.Id, selection.ExistingProjectId, selection.NewProjectName);
        assignBusy = false;

        if (error != null)
        {
            assignError = error;
            return;
        }

        CloseAssignProject();
        Load();
    }
}
